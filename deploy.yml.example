# GitHub Actions Workflow per Deploy Automatico
# 
# Questo workflow viene eseguito automaticamente quando:
# - Fai push sul branch main
# - Modifichi file HTML, CSS o JS
#
# Per abilitarlo:
# 1. Crea la cartella .github/workflows/
# 2. Rinomina questo file in deploy.yml
# 3. Spostalo in .github/workflows/deploy.yml

name: Deploy to GitHub Pages

on:
  push:
    branches:
      - main
    paths:
      - '**.html'
      - '**.css'
      - '**.js'
      - 'assets/**'
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Pages
        uses: actions/configure-pages@v4

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: '.'

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4

      - name: Success Notification
        run: |
          echo "✅ Deployment completato!"
          echo "🌐 Il sito è ora live su GitHub Pages"
